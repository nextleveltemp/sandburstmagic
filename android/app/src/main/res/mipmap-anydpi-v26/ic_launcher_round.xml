<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). Layers are generated from the
     official artwork by tool/generate_icons.py. The artwork, including its
     neon frame, sits inside the 66 dp safe zone, so every launcher mask
     (circle, squircle, rounded square, teardrop) shows it in full. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
