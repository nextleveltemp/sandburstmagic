<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: game progress and settings may be included in cloud backup
     and device-to-device transfer. No account or server is involved. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
